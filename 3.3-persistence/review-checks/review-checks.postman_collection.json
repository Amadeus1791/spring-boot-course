      "description": "Lab 3.2: create, read and change reviews.",
      "item": [
        {
          "name": "REV-2.1 Valid review for event 1",
          "id": "3ff68656-04f2-5a18-a684-00020b1197f2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const ctype = (pm.response.headers.get(\"Content-Type\") || \"\").split(\";\")[0].trim();",
                  "const location = pm.response.headers.get(\"Location\");",
                  "const wwwAuth = pm.response.headers.get(\"WWW-Authenticate\");",
                  "const requestId = pm.response.headers.get(\"X-Request-Id\");",
                  "let body = null;",
                  "try { body = pm.response.json(); } catch (e) { body = null; }",
                  "pm.test(\"status 201\", function () {",
                  "    pm.expect(status === 201, \"status was \" + status).to.be.true;",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(ctype === \"application/json\", \"Content-Type: \" + ctype).to.be.true;",
                  "});",
                  "pm.test(\"Location ends with /api/reviews/{id}\", function () {",
                  "    pm.expect(location !== null && location !== undefined && /\\/api\\/reviews\\/\\d+$/.test(location) && location.endsWith(\"/api/reviews/\" + body.id), \"Location: \" + location).to.be.true;",
                  "});",
                  "pm.test(\"body has id, eventId, author, stars, text, createdAt\", function () {",
                  "    pm.expect(body !== null && body.id !== undefined && body.eventId !== undefined && body.author !== undefined && body.stars !== undefined && \"text\" in body && body.createdAt !== undefined, JSON.stringify(body)).to.be.true;",
                  "});",
                  "pm.test(\"body shows the stored values\", function () {",
                  "    pm.expect(body.eventId === 1 && body.author === \"Alice\" && body.stars === 4, JSON.stringify(body)).to.be.true;",
                  "});",
                  "if (body !== null) { pm.collectionVariables.set(\"reviewLocation\", String(location)); }",
                  "if (body !== null) { pm.collectionVariables.set(\"reviewId\", String(body.id)); }",
                  "if (body !== null) { pm.collectionVariables.set(\"reviewCreatedAt\", String(body.createdAt)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reviewUrl}}/api/events/1/reviews",
              "host": [
                "{{reviewUrl}}"
              ],
              "path": [
                "api",
                "events",
                "1",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Alice\",\n  \"stars\": 4,\n  \"text\": \"Great evening, good sound.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
