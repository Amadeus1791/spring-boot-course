    {
      "name": "REV-3",
      "id": "50552919-e448-58e6-aa9d-1b4ef7f58ce8",
      "description": "Lab 3.3: per event and average. A new random event id per run. Run REV-2 along.",
      "item": [
        {
          "name": "REV-3.1 Rating of a new event, before any review",
          "id": "6f59e248-46a2-5018-a8c6-a754d6bc5f30",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"ratingEventId\", String(100000 + Math.floor(Math.random() * 900000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
