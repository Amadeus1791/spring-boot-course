# Checks for lab 3.3 (REV-3): reviews per event, page by page, with an average.
# The REV-2 checks run along: the API from 3.2 must answer as before.
# The REV-3 checks use a new random event id per run, so earlier runs do not count.
# Run against your own review-service on port 8083 (change reviewUrl below if needed).
# IntelliJ IDEA Ultimate: "Run All Requests in File"; each test shows green or red.
# The same checks are in review-checks.postman_collection.json (Collection Runner).
# Order-safe: the checks create what they read and take ids from the responses.
@reviewUrl = http://localhost:8083

# ----------------------------------------------------------------------
# REV-2 (runs along)
# ----------------------------------------------------------------------

### REV-2.1 Valid review for event 1
POST {{reviewUrl}}/api/events/1/reviews
Content-Type: application/json

{"author": "Alice", "stars": 4, "text": "Great evening, good sound."}

> {%
    const status = response.status;
    const ctype = response.contentType ? response.contentType.mimeType : null;
    const location = response.headers.valueOf("Location");
    const wwwAuth = response.headers.valueOf("WWW-Authenticate");
    const requestId = response.headers.valueOf("X-Request-Id");
    let body = response.body;
    if (typeof body === "string") { try { body = JSON.parse(body); } catch (e) { body = null; } }
    if (body === undefined || body === "") { body = null; }
    client.test("status 201", function () {
        client.assert(status === 201, "status was " + status);
    });
    client.test("Content-Type is application/json", function () {
        client.assert(ctype === "application/json", "Content-Type: " + ctype);
    });
    client.test("Location ends with /api/reviews/{id}", function () {
        client.assert(location !== null && location !== undefined && /\/api\/reviews\/\d+$/.test(location) && location.endsWith("/api/reviews/" + body.id), "Location: " + location);
    });
    client.test("body has id, eventId, author, stars, text, createdAt", function () {
        client.assert(body !== null && body.id !== undefined && body.eventId !== undefined && body.author !== undefined && body.stars !== undefined && "text" in body && body.createdAt !== undefined, JSON.stringify(body));
    });
    client.test("body shows the stored values", function () {
        client.assert(body.eventId === 1 && body.author === "Alice" && body.stars === 4, JSON.stringify(body));
    });
    if (body !== null) { client.global.set("reviewLocation", String(location)); }
    if (body !== null) { client.global.set("reviewId", String(body.id)); }
    if (body !== null) { client.global.set("reviewCreatedAt", String(body.createdAt)); }
%}

### REV-2.2 GET the Location
GET {{reviewLocation}}

> {%
    const status = response.status;
    const ctype = response.contentType ? response.contentType.mimeType : null;
    const location = response.headers.valueOf("Location");
    const wwwAuth = response.headers.valueOf("WWW-Authenticate");
    const requestId = response.headers.valueOf("X-Request-Id");
    let body = response.body;
    if (typeof body === "string") { try { body = JSON.parse(body); } catch (e) { body = null; } }
    if (body === undefined || body === "") { body = null; }
    client.test("status 200", function () {
        client.assert(status === 200, "status was " + status);
    });
    client.test("Content-Type is application/json", function () {
        client.assert(ctype === "application/json", "Content-Type: " + ctype);
    });
    client.test("body has id, eventId, author, stars, text, createdAt", function () {
        client.assert(body !== null && body.id !== undefined && body.eventId !== undefined && body.author !== undefined && body.stars !== undefined && "text" in body && body.createdAt !== undefined, JSON.stringify(body));
    });
    client.test("same review as created", function () {
        client.assert(String(body.id) === String(client.global.get("reviewId")) && body.author === "Alice" && body.stars === 4, JSON.stringify(body));
    });
%}

### REV-2.3 PUT: change stars and text
PUT {{reviewUrl}}/api/reviews/{{reviewId}}
Content-Type: application/json

{"stars": 3, "text": "Good evening, but the sound was too loud."}

> {%
    const status = response.status;
    const ctype = response.contentType ? response.contentType.mimeType : null;
    const location = response.headers.valueOf("Location");
    const wwwAuth = response.headers.valueOf("WWW-Authenticate");
    const requestId = response.headers.valueOf("X-Request-Id");
    let body = response.body;
    if (typeof body === "string") { try { body = JSON.parse(body); } catch (e) { body = null; } }
    if (body === undefined || body === "") { body = null; }
    client.test("status 200", function () {
        client.assert(status === 200, "status was " + status);
    });
    client.test("Content-Type is application/json", function () {
        client.assert(ctype === "application/json", "Content-Type: " + ctype);
    });
    client.test("body has id, eventId, author, stars, text, createdAt", function () {
        client.assert(body !== null && body.id !== undefined && body.eventId !== undefined && body.author !== undefined && body.stars !== undefined && "text" in body && body.createdAt !== undefined, JSON.stringify(body));
    });
    client.test("stars and text changed", function () {
        client.assert(body.stars === 3 && body.text === "Good evening, but the sound was too loud.", JSON.stringify(body));
    });
    client.test("same id, author and createdAt", function () {
        client.assert(String(body.id) === String(client.global.get("reviewId")) && body.author === "Alice" && String(body.createdAt) === String(client.global.get("reviewCreatedAt")), JSON.stringify(body));
    });
%}

### REV-2.4 PUT: two stars without text
PUT {{reviewUrl}}/api/reviews/{{reviewId}}
Content-Type: application/json

{"stars": 2}

> {%
    const status = response.status;
    const ctype = response.contentType ? response.contentType.mimeType : null;
    const location = response.headers.valueOf("Location");
    const wwwAuth = response.headers.valueOf("WWW-Authenticate");
    const requestId = response.headers.valueOf("X-Request-Id");
    let body = response.body;
    if (typeof body === "string") { try { body = JSON.parse(body); } catch (e) { body = null; } }
    if (body === undefined || body === "") { body = null; }
    client.test("status 400", function () {
        client.assert(status === 400, "status was " + status);
    });
    client.test("Content-Type is application/problem+json", function () {
        client.assert(ctype === "application/problem+json", "Content-Type: " + ctype);
    });
    client.test("body has a title", function () {
        client.assert(body !== null && typeof body.title === "string" && body.title.length > 0, "title: " + (body && body.title));
    });
    client.test("errors.text", function () {
        client.assert(body.errors !== undefined && body.errors !== null && body.errors.text !== undefined, JSON.stringify(body.errors));
    });
%}

